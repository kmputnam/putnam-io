---
import site from "../data/site";
import "../styles/global.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const {
  title,
  description = `Executive profile for ${site.name} focused on product strategy and platform architecture.`,
  currentPath,
  noindex = false,
  type = "website"
} = Astro.props as Props;

const pathname = currentPath ?? Astro.url.pathname;
const isHomeActive = pathname === "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `${title} | ${site.name}`;
const socialImage = new URL("/assets/icons/android-chrome-512x512.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Kyle Putnam north marker icon" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {/* Keep both root and /assets icon links to satisfy Safari + legacy favicon lookups. */}
    <meta name="theme-color" content="#1D4ED8" />
    <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate icon" href="/assets/icons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#1D4ED8" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" aria-label="Primary">
      <div class="container header-inner">
        <a class={`header-home${isHomeActive ? " is-active" : ""}`} href="/" aria-current={isHomeActive ? "page" : undefined}>Home</a>
        <nav class="site-nav" aria-label="Primary navigation">
          {
            site.nav.map((item) => {
              // Keep parent sections active for nested routes like /writing/some-post/.
              const isActive = pathname === item.href || (pathname && item.href !== "/" && pathname.startsWith(item.href));

              return (
                <a class={isActive ? "is-active" : undefined} href={item.href} aria-current={pathname === item.href ? "page" : isActive ? "location" : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="main-content" class="container main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
